# Optional overrides for `docker compose` (copy to .env). Defaults are dev-only.
# Must match docker/centrifugo.json's token_hmac_secret_key if you keep the JSON value.
# CENTRIFUGO_HMAC_SECRET=dev-only-hmac-secret-change-me-0123456789abcdef
# Change if something else already owns host port 6379.
# REDIS_HOST_PORT=6379
