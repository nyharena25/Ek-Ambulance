# Staff KYC review console. Copy to .env and fill in. ONLY the public anon/publishable key belongs here:
# everything in a VITE_* variable is bundled into the page. vite.config.ts refuses to build with a secret key.
# Either the local stack directly (http://127.0.0.1:54321) or a Kong gateway (docker/kong.local.yml or docker/kong.yml,
# http://127.0.0.1:8000); both have the /storage/v1/object route and the browser CORS headers this console needs.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
