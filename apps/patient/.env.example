# Copy to .env and fill in real values. Never commit .env - only this
# .example file is tracked (see the root .gitignore's `.env*` / `!.env.example`).
#
# Persistence and auth use a remote Supabase instance in AWS Mumbai
# (ap-south-1). Client calls route through the Kong API gateway, not the
# raw Supabase project URL directly (see src/lib/supabaseClient.ts).

# Raw Supabase project URL (ap-south-1). Not read by supabaseClient.ts
# today (that routes through EXPO_PUBLIC_GATEWAY_URL instead) - validated
# here for whatever eventually needs the direct project URL.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Kong API gateway - all GoTrue/REST calls route through this, not Supabase directly.
# Defaults to http://localhost:8000 (use `pnpm adb:reverse` on a USB device).
# Kong (docker compose up -> `pnpm services:up`).
#   Android emulator:  http://10.0.2.2:8000
#   Physical device:   http://<LAN_IP>:8000  (or USB: `pnpm adb:reverse`, then http://localhost:8000)
EXPO_PUBLIC_GATEWAY_URL=http://10.0.2.2:8000

# Centrifugo v5 WebSocket endpoint for mission:{id} realtime channels.
# Centrifugo WebSocket (host port 8001 -> container 8000). centrifuge-js needs ws://, not http://.
#   Android emulator:  ws://10.0.2.2:8001/connection/websocket
#   Physical device:   ws://<LAN_IP>:8001/connection/websocket  (or USB: `pnpm adb:reverse`, then ws://localhost:8001/...)
EXPO_PUBLIC_CENTRIFUGO_WS_URL=ws://10.0.2.2:8001/connection/websocket

# Optional model override for the "Describe the Emergency" triage assistant. The OpenRouter API key itself
# is server-side only now (docker-compose.yml's token-mint OPENROUTER_API_KEY) - the client calls
# /triage/extract on the gateway with the signed-in patient's own session token, never an API key. No real
# session (e.g. the anonymous quick-emergency path) means the assistant is unavailable and the app falls
# back to the manual questionnaire, same as an unset key used to.
EXPO_PUBLIC_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Google Maps SDK for Android key (Maps SDK for Android enabled; restrict it to the app's package + SHA-1).
# Baked into the manifest at prebuild and read by MapViewPort to decide whether to mount the native map.
# Leave blank to run with the static map fallback. iOS uses Apple Maps and needs no key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
