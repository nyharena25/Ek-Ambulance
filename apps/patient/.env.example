# Copy to .env and fill in real values. Never commit .env - only this
# .example file is tracked (see the root .gitignore's `.env*` / `!.env.example`).
#
# Persistence and auth use a remote Supabase instance in AWS Mumbai
# (ap-south-1). Client calls route through the Kong API gateway, not the
# raw Supabase project URL directly (see src/lib/supabaseClient.ts).

# Raw Supabase project URL (ap-south-1). Not read by supabaseClient.ts
# today (that routes through EXPO_PUBLIC_GATEWAY_URL instead) - validated
# here for whatever eventually needs the direct project URL.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Kong API gateway - all GoTrue/REST calls route through this, not Supabase directly.
EXPO_PUBLIC_GATEWAY_URL=https://api.sahayak.in

# Centrifugo v5 WebSocket endpoint for mission:{id} realtime channels.
EXPO_PUBLIC_CENTRIFUGO_WS_URL=wss://realtime.sahayak.in/connection/websocket
