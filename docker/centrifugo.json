{
  "token_hmac_secret_key": "dev-only-hmac-secret-change-me-0123456789abcdef",
  "admin": true,
  "admin_password": "dev-admin-password",
  "admin_secret": "dev-admin-secret",
  "api_key": "dev-api-key",
  "allow_anonymous_connect_without_token": true,
  "allowed_origins": ["*"],
  "engine": "redis",
  "redis_address": "redis:6379",
  "client_channel_limit": 10,
  "namespaces": [
    {
      "name": "mission",
      "allow_publish_for_client": true,
      "history_size": 20,
      "history_ttl": "300s",
      "force_recovery": true
    },
    {
      "name": "driver",
      "history_size": 5,
      "history_ttl": "60s",
      "force_recovery": true
    }
  ]
}
