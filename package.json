{
  "name": "ek-ambulance-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:patient": "pnpm --filter @sahayak/patient dev",
    "dev:driver": "pnpm --filter @sahayak/driver dev",
    "dev:all": "turbo run dev --filter=@sahayak/patient --filter=@sahayak/driver",
    "adb:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8082 tcp:8082 && adb reverse tcp:8000 tcp:8000 && adb reverse tcp:8001 tcp:8001",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "test:schema": "node --experimental-strip-types supabase/tests/schema_validation.test.ts && node --experimental-strip-types supabase/tests/data_sync_schema.test.ts",
    "test:gateway": "node --experimental-strip-types docker/mock-gateway/gateway.test.mjs && node docker/kong.config.test.mjs",
    "preflight": "turbo run typecheck test --force && pnpm test:schema && pnpm test:gateway && pnpm test:integrity && pnpm test:security",
    "test:integrity": "node scripts/production-data-integrity.test.mjs",
    "test:security": "node scripts/security-static.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.6.6",
      "deepmerge": "4.3.0",
      "@xmldom/xmldom": "^0.8.15"
    }
  }
}
