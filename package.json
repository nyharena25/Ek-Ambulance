{
  "name": "ek-ambulance-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:patient": "pnpm --filter @sahayak/patient dev",
    "dev:driver": "pnpm --filter @sahayak/driver dev",
    "dev:all": "turbo run dev --filter=@sahayak/patient --filter=@sahayak/driver",
    "preflight": "turbo run typecheck lint test --force"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "eslint": "^8.57.0"
  }
}
